{
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [],
    dependencyDashboard: {
        enabled: true,
    },
    customManagers: [
        {
            customType: 'regex',
            managerFilePatterns: [
                '/^conandata.yml$/',
            ],
            matchStrings: [
                'conan: "(?<depName>.*?)/(?<currentValue>.*?)"',
            ],
            packageNameTemplate: '{{depName}}/{{currentValue}}@_/_',
            depTypeTemplate: 'requires',
            datasourceTemplate: 'conan',
            versioningTemplate: 'conan',
        },
    ],
    enabledManagers: [
        'custom.regex',
        'github-actions',
        'npm',
        'dockerfile',
    ],
    packageRules: [
        {
            matchManagers: [
                'github-actions',
            ],
            groupName: 'github-actions',
            separateMajorMinor: false,
        },
        {
            matchManagers: [
                'npm',
            ],
            groupName: 'npm',
            separateMajorMinor: false,
        },
        {
            matchManagers: [
                'dockerfile',
            ],
        },
        {
            matchManagers: [
                'custom.regex',
            ],
            matchUpdateTypes: [
                'patch',
            ],
            groupName: 'conan dependencies',
            groupSlug: 'conan-deps-patch',
        },
        {
            matchManagers: [
                'custom.regex',
            ],
            matchDepNames: [
                'spirv-cross',
            ],
            enabled: false,
        },
    ],
    dependencyDashboardApproval: true,
    semanticCommits: 'disabled',
    labels: [
        'deps',
    ],
}
